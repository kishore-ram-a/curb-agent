generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AuditEvent {
  id        String   @id @default(cuid())
  eventType String
  actor     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
}